.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# NGSIM is downloaded separately and must not be committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated checkpoints and metrics are intentionally excluded.
results/regenerated/*
!results/regenerated/.gitkeep
*.pt
*.pth
